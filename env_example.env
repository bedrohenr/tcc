# influxdb
INFLUXDB_PORT_IN=8086
INFLUXDB_PORT_OUT=8086
INFLUXDB_MODE=setup
INFLUXDB_USERNAME=<username_influxdb>
INFLUXDB_PASSWORD=<senha_influxdb>
INFLUXDB_ORG=sdn_org
INFLUXDB_BUCKET=sdn_metrics
INFLUXDB_ADMIN_TOKEN=<seu_token>

# grafana
GRAFANA_PORT_IN=3000
GRAFANA_PORT_OUT=3000
GRAFANA_ADMIN_USER=<username_grafana>
GRAFANA_ADMIN_PASSWORD=<senha_grafana>